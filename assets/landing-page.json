          "defaultValue": 1500,
          "format": "currency",
          "group": "economics"
        },
        {
          "id": "allocation_volume",
          "label": "Share used to absorb more volume",
          "help": "Throughput: extra work the same team can take. Valued as capacity creation, not cash leaving payroll.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 50,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "allocation_billable",
          "label": "Share used for higher-value / billable work",
          "help": "Positive productivity: advisory, selling, or other contribution-margin work.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 25,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "allocation_cost_reduction",
          "label": "Share that is genuine cost reduction",
          "help": "Negative productivity removed as cash: overtime, contractors, or work you would otherwise pay for.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 17,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "contribution_rate",
          "label": "Contribution margin / hour of higher-value work",
          "help": "Used only for the billable/advisory share. This is not an hourly salary.",
          "type": "slider",
          "min": 20,
          "max": 400,
          "step": 5,
          "defaultValue": 150,
          "format": "currency",
          "group": "allocation"
        },
        {
          "id": "expected_error_cost",
          "label": "Expected monthly error / rework cost today",
          "type": "slider",
          "min": 0,
          "max": 20000,
