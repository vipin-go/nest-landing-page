          "step": 5,
          "defaultValue": 90,
          "format": "currency",
          "group": "profile",
          "profile": true
        },
        {
          "id": "hours_per_intro",
          "label": "Agent hours per introduction today",
          "type": "slider",
          "min": 0.5,
          "max": 10,
          "step": 0.5,
          "defaultValue": 2,
          "format": "hours",
          "group": "workload"
        },
        {
          "id": "automation_share",
          "label": "Share of matching work automated",
